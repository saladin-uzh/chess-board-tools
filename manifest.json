{
  "manifest_version": 3,
  "name": "Chess Board Tools",
  "version": "1.2.0",
  "description": "Keyboard controls, move confirmation shortcuts, turn sound cues, and optional Piece Vision Overlay for supported Chess.com boards.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Chess Board Tools",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/play/*",
        "https://www.chess.com/game/*",
        "https://www.chess.com/analysis",
        "https://www.chess.com/analysis?*",
        "https://www.chess.com/analysis/game/*"
      ],
      "js": [
        "settings.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "fog-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "settings.js",
        "fog-visibility.js",
        "fog-board.js",
        "fog-content.js"
      ],
      "css": [
        "fog.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "assist-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "settings.js",
        "assist-board.js",
        "assist-timer.js",
        "assist-content.js"
      ],
      "css": [
        "assist.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
